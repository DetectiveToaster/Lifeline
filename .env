APP_ENV=dev

# Secrets
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me

# Optional services
REDIS_URL=redis://localhost:6379/0
DB_URL=
FCM_SERVER_KEY=

# JWT / timing
JWT_EXP_DAYS=30
MATCHING_MAX_WAIT_SECONDS=30
PENDING_ACCEPT_TIMEOUT_SECONDS=20
SESSION_DURATION_SECONDS=300
SESSION_GRACE_PERIOD_SECONDS=5

# WebSocket limits
MAX_WS_PER_TOKEN=2
MAX_WS_PER_IP=10
IDLE_TIMEOUT_SECONDS=60
MAX_MESSAGE_BYTES=2000
MAX_MESSAGES_PER_MIN=60

# Rate limits
SEEKER_SESSION_RATE_PER_HOUR=5
VOLUNTEER_ACCEPT_RATE_PER_HOUR=60
IP_BLOCK_THRESHOLD_SCORE=10
IP_BLOCK_DURATION_MINUTES=60

# Retention
LOG_RETENTION_DAYS=30
METRICS_RETENTION_DAYS=365
INCIDENT_RETENTION_DAYS=90
BAN_RETENTION_DAYS=365

# Moderation thresholds
ABUSE_END_SESSION_THRESHOLD=2
ABUSE_BAN_THRESHOLD=3
SELF_HARM_CRISIS_THRESHOLD=2

# Crisis message (override per locale in code if needed)
CRISIS_RESOURCE_MESSAGE=If you are in immediate danger or thinking about self-harm, please contact local emergency services or a crisis hotline in your area.
